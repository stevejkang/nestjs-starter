{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [],
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      { "groupName": "nestjs", "elementNamePattern": ["@nestjs/**"] },
      { "groupName": "shared", "elementNamePattern": ["@shared/**"] }
    ],
    "groups": ["builtin", "external", "nestjs", "shared", ["parent", "sibling", "index"], "unknown"]
  }
}
